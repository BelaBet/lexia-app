VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Configure these in Supabase Edge Functions secrets, not in the frontend.
# Required by legal-chat, pdf-ocr and suggest-checklist-items (all call
# OpenAI directly — no Lovable AI Gateway dependency).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional. Vision-capable model override just for pdf-ocr (falls back to
# OPENAI_MODEL, then gpt-4.1-mini).
# OPENAI_OCR_MODEL=gpt-4.1-mini

# Optional. Comma-separated list of exact origins allowed to call the edge
# functions (e.g. "https://app.example.com,https://staging.example.com").
# Leave unset to allow any origin (previous, more permissive default).
# ALLOWED_ORIGINS=

# Optional. Tunes the per-user AI chat rate limit (legal-chat function).
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW_SECONDS=300
